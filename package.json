  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "clean": "rm -rf dist",
    "copy:files": "copy README.md .\\dist\\lib\\ && copy LICENSE .\\dist\\lib\\",
    "build:git:demo": "ng build --configuration production",
    "build:library": "ng test ngx-library --watch=false && ng build ngx-library && npm run copy:files && npm run build:git:demo",
    "build:publish": "npm publish dist/lib/ --access public --tag=latest"
  },
  "private": true,

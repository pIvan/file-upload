    "karma-jasmine-html-reporter": "^1.5.0",
    "ng-packagr": "^22.0.0",
    "protractor": "~7.0.0",
    "ts-node": "~7.0.0",
    "tslint": "~6.1.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"

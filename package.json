    "@angular/router": "^22.0.0",
    "bootstrap": "4.3.1",
    "highlight.js": "^11.10.0",
    "rxjs": "^7.5.3",
    "tslib": "^2.3.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
